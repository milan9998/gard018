# Docker image koji server preuzima iz GitHub Container Registry-ja
APP_IMAGE=ghcr.io/milan9998/gard018:latest

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_BASE_URL=https://app.gard018.com
TZ=Europe/Belgrade

# Svaku vrednost generisati posebno; minimum 32 nasumična karaktera.
SESSION_SECRET=CHANGE_ME_WITH_RANDOM_64_CHAR_SECRET
QR_SECRET=CHANGE_ME_WITH_DIFFERENT_RANDOM_64_CHAR_SECRET
CRON_SECRET=CHANGE_ME_WITH_DIFFERENT_RANDOM_64_CHAR_SECRET

# Opciono: aplikacija sama generiše i čuva ključeve u bazi ako se izostave.
# Ručno generisanje: pnpm push:generate-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=CHANGE_ME_WITH_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=CHANGE_ME_WITH_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:info@gard018.com

RESEND_API_KEY=CHANGE_ME_WITH_ROTATED_RESEND_API_KEY

POSTGRES_DB=gard018
POSTGRES_USER=gard018
POSTGRES_PASSWORD=CHANGE_ME_WITH_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://gard018:CHANGE_ME_WITH_STRONG_DATABASE_PASSWORD@postgres:5432/gard018
DB_POOL_MAX=10
DB_SSL=false

UPLOAD_DIR=/app/uploads
